<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Leer los SMS guardados en el celular: sin esto no hay conversaciones para mostrar. -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Poner nombre y foto a los números y elegir a quién escribir. Solo lectura. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
        Qué chips hay, su nombre, color y si tienen servicio, para elegir con cuál enviar. No da el
        número de la línea (ese es READ_PHONE_NUMBERS, que se quita abajo).
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
        Enviar, recibir y guardar SMS y MMS: solo los usa siendo la app de SMS predeterminada (el
        sistema no le entrega mensajes a otra). Enviar sale siempre por un pedido tuyo, nunca solo.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />

    <!--
        Bloqueo de la app con la huella, la cara o el PIN del celular (opcional, en Ajustes). Es un
        permiso común: la app nunca ve la huella ni el PIN, solo si se desbloqueó.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        Mensajes programados: después de reiniciar el celular hay que volver a poner sus alarmas
        (el sistema las borra). No se pide el permiso de alarmas exactas: pueden salir unos minutos
        después de la hora con el celular en reposo.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Avisar cuando llega un mensaje. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--

        Nunca: internet (los MMS los baja y los manda el sistema), ubicación ni el número de la
        línea. Se quitan también si alguna librería los pide.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove" />

    <!-- Sin telefonía (una tablet) la app abre igual: solo no puede enviar. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
        Fuera lo que agregan las librerías y la app no usa, para que el manifest final solo tenga
        componentes propios: el permiso interno de androidx.core para receptores dinámicos,
        androidx.startup (arrancaría emoji2, que puede pedir fuentes a Google Play Services) y el
        receptor de profileinstaller.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- Sin backup ni transferencia de datos a otro dispositivo (ver data_extraction_rules). -->
    <application
        android:name=".MessagesApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@android:drawable/sym_action_chat"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidMessages">

        <!-- Ícono provisorio: los de la suite van después de que apruebes la muestra. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Mensaje" desde Phone, Contacts u otra app: abre la conversación con el texto escrito, sin enviar. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <!-- Compartir un texto o una foto desde otra app: elegís a quién y se envía cuando lo tocás. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- SMS que llega. Solo el sistema puede mandarlo (BROADCAST_SMS). -->
        <receiver
            android:name=".receive.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Aviso de MMS. Solo el sistema puede mandarlo (BROADCAST_WAP_PUSH). -->
        <receiver
            android:name=".receive.MmsWapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Responder con un mensaje al rechazar una llamada. Solo el sistema (SEND_RESPOND_VIA_MESSAGE). -->
        <service
            android:name=".receive.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Resultados de enviar y bajar, y acciones de las notificaciones: solo los llama la propia app. -->
        <receiver android:name=".sms.SmsStatusReceiver" android:exported="false" />
        <receiver android:name=".mms.MmsResultReceiver" android:exported="false" />
        <receiver android:name=".notify.NotificationActionReceiver" android:exported="false" />
        <receiver android:name=".schedule.ScheduledReceiver" android:exported="false" />
        <!-- Solo el sistema manda BOOT_COMPLETED; el receptor no usa nada del intent. -->
        <receiver android:name=".schedule.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Archivos de los MMS en tránsito, compartidos solo con el servicio de MMS del sistema. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mms"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mms_files" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
