<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Etapa 0: sin ningún permiso. Los de SMS, contactos y chips se suman en las etapas 1 y 2,
        cada uno con su motivo al lado.

        Nunca: internet (los MMS los baja y los manda el sistema), ubicación ni el número de la
        línea. Se quitan también si alguna librería los pide.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove" />

    <!-- Sin telefonía (una tablet) la app abre igual: solo no puede enviar. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
        Fuera lo que agregan las librerías y la app no usa, para que el manifest final solo tenga
        componentes propios: el permiso interno de androidx.core para receptores dinámicos,
        androidx.startup (arrancaría emoji2, que puede pedir fuentes a Google Play Services) y el
        receptor de profileinstaller.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- Sin backup ni transferencia de datos a otro dispositivo (ver data_extraction_rules). -->
    <application
        android:name=".MessagesApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@android:drawable/sym_action_chat"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidMessages">

        <!-- Ícono provisorio: los de la suite van después de que apruebes la muestra. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
